@PACKAGE_INIT@

set(VoxelEngine_Authoring_FOUND FALSE)
set(VoxelEngine_SDK_FOUND FALSE)

if (EXISTS "${CMAKE_CURRENT_LIST_DIR}/VoxelEngineAuthoringTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/VoxelEngineAuthoringTargets.cmake")
    set(VoxelEngine_Authoring_FOUND TRUE)
endif()

macro(_voxel_engine_find_sdk_dependency dependency)
    if (_voxel_engine_sdk_dependencies_found)
        if (VoxelEngine_FIND_REQUIRED_SDK)
            find_dependency(${dependency} ${ARGN})
        else()
            find_package(${dependency} QUIET ${ARGN})
            if (NOT ${dependency}_FOUND)
                set(_voxel_engine_sdk_dependencies_found FALSE)
            endif()
        endif()
    endif()
endmacro()

set(_voxel_engine_sdk_targets
    "${CMAKE_CURRENT_LIST_DIR}/VoxelEngineSdkTargets.cmake")
if ("SDK" IN_LIST VoxelEngine_FIND_COMPONENTS AND
        VoxelEngine_Authoring_FOUND AND EXISTS "${_voxel_engine_sdk_targets}")
    include(CMakeFindDependencyMacro)
    set(_voxel_engine_sdk_dependencies_found TRUE)
    _voxel_engine_find_sdk_dependency(Threads)
    _voxel_engine_find_sdk_dependency(GLEW CONFIG)
    _voxel_engine_find_sdk_dependency(glfw3 CONFIG)
    _voxel_engine_find_sdk_dependency(glm CONFIG)
    _voxel_engine_find_sdk_dependency(assimp CONFIG)
    _voxel_engine_find_sdk_dependency(Boost CONFIG COMPONENTS container)
    _voxel_engine_find_sdk_dependency(imgui CONFIG)
    _voxel_engine_find_sdk_dependency(spdlog CONFIG)
    _voxel_engine_find_sdk_dependency(volk CONFIG)
    _voxel_engine_find_sdk_dependency(VulkanHeaders CONFIG)
    _voxel_engine_find_sdk_dependency(VulkanMemoryAllocator CONFIG)
    _voxel_engine_find_sdk_dependency(xsimd CONFIG)
    if (_voxel_engine_sdk_dependencies_found)
        include("${_voxel_engine_sdk_targets}")
        set(VoxelEngine_SDK_FOUND TRUE)
    endif()
endif()

unset(_voxel_engine_sdk_dependencies_found)
unset(_voxel_engine_sdk_targets)

foreach(component IN LISTS VoxelEngine_FIND_COMPONENTS)
    if (NOT component STREQUAL "Authoring" AND NOT component STREQUAL "SDK")
        set(VoxelEngine_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(VoxelEngine)
