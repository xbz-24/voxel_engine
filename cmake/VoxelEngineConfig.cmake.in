@PACKAGE_INIT@

set(VoxelEngine_Authoring_FOUND FALSE)
set(VoxelEngine_SDK_FOUND FALSE)

if (EXISTS "${CMAKE_CURRENT_LIST_DIR}/VoxelEngineAuthoringTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/VoxelEngineAuthoringTargets.cmake")
    set(VoxelEngine_Authoring_FOUND TRUE)
endif()

if ("SDK" IN_LIST VoxelEngine_FIND_COMPONENTS)
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
    find_dependency(GLEW CONFIG)
    find_dependency(glfw3 CONFIG)
    find_dependency(glm CONFIG)
    find_dependency(assimp CONFIG)
    find_dependency(Boost CONFIG COMPONENTS container)
    find_dependency(imgui CONFIG)
    find_dependency(spdlog CONFIG)
    find_dependency(volk CONFIG)
    find_dependency(VulkanHeaders CONFIG)
    find_dependency(VulkanMemoryAllocator CONFIG)
    find_dependency(xsimd CONFIG)
    if (VoxelEngine_Authoring_FOUND AND
            EXISTS "${CMAKE_CURRENT_LIST_DIR}/VoxelEngineSdkTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/VoxelEngineSdkTargets.cmake")
        set(VoxelEngine_SDK_FOUND TRUE)
    endif()
endif()

foreach(component IN LISTS VoxelEngine_FIND_COMPONENTS)
    if (NOT component STREQUAL "Authoring" AND NOT component STREQUAL "SDK")
        set(VoxelEngine_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(VoxelEngine)
